# Copy to .env and fill in. .env is git-ignored.
TALLY_HOST=localhost
TALLY_PORT=9000
# Optional limits for staff machines (comma-separated; empty = everything):
ALLOWED_COMPANIES=
ALLOWED_TOOLS=
# Route B (remote connector) only:
PORT=3000
MCP_DOMAIN=https://tally.yourdomain.in
PASSWORD=change-me-to-a-long-random-password
